# development | production (production'da zayıf SECRET_KEY ile sunucu başlamaz)
ENVIRONMENT=development

# En az 32 karakter. Üret: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Oturum yenileme token'ının ömrü (gün). Uygulama bu süre boyunca yeniden giriş istemez.
REFRESH_TOKEN_EXPIRE_DAYS=30
DATABASE_URL=sqlite:///./app.db

# Web istemcisi kullanılacaksa izinli origin'ler (virgülle). Mobil için boş bırak.
CORS_ORIGINS=

# Gemini API Key (AI özellikleri için; yoksa OpenAI, o da yoksa demo mod)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (opsiyonel)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- E-posta (şifre sıfırlama ve doğrulama kodları) ---
# development: console (kodu sunucu loguna yazar) | production: smtp zorunlu
EMAIL_BACKEND=console
EMAIL_FROM=Smart Assistant <no-reply@ornek.com>
# EMAIL_BACKEND=smtp ise:
# SMTP_HOST=smtp.ornek.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true

# true: kayıttan sonra e-posta doğrulanmadan giriş yapılamaz (SMTP gerekir)
REQUIRE_EMAIL_VERIFICATION=false

# Kullanıcı başına saklanacak en fazla sohbet mesajı
MAX_STORED_MESSAGES=500
